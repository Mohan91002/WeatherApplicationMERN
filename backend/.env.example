# Copy to .env and adjust. All values have sensible defaults, so the API runs
# with none of these set (it will degrade gracefully without MongoDB).

# HTTP port the API listens on.
PORT=5135

# MongoDB connection string. If unreachable, the API falls back to the
# in-memory country seed (the app still runs, but nothing is persisted).
MONGODB_URI=mongodb://127.0.0.1:27017/weather

# Comma-separated list of SPA origins allowed by CORS.
# Vite dev server default is http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173
