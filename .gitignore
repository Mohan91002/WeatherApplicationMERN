# ---------------------------------------------------------------------------
# Node / build artifacts  (backend/ and frontend/.gitignore also cover these)
# ---------------------------------------------------------------------------
**/node_modules/
**/dist/
**/out-tsc/
**/coverage/
**/.vite/
npm-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Secrets — the backend .env may hold a real MONGODB_URI (backend/.gitignore
# also covers this). The frontend .env holds only the localhost dev default and
# IS committed so the app works after a fresh clone.
# ---------------------------------------------------------------------------
backend/.env
backend/.env.local

# ---------------------------------------------------------------------------
# Terraform  (infra/.gitignore also covers these within infra/)
# ---------------------------------------------------------------------------
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
crash.log

# ---------------------------------------------------------------------------
# CodeCarbon emissions-tracking output (generated measurement artifacts)
# ---------------------------------------------------------------------------
emissions.csv
.codecarbon*

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
